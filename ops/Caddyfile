# Один вход для интерфейса и API.
#
# Прокси нужен не для красоты: фронт и API обязаны быть одного
# происхождения, иначе сессионная cookie с SameSite=Strict не доедет.
# Сюда же позже встанет ATT&CK Navigator, и по той же причине —
# iframe с ним должен быть same-origin, чтобы навязать ему тему.

:80 {
	encode gzip

	# API проксируется как есть, префикс сохраняется.
	# Потолок тела — наибольший из лимитов API (500 МБ у VM) с запасом
	# на multipart; точные лимиты по путям держит сам API (api/limits.py).
	handle /api/* {
		request_body {
			max_size 600MB
		}
		reverse_proxy api:8000
	}

	# Ресурсы с хешем в имени неизменяемы: имя меняется вместе
	# с содержимым, поэтому их можно кешировать надолго.
	handle /assets/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Всё остальное — статика интерфейса с фолбэком на index.html:
	# маршрутизация клиентская, и прямой заход на /hygiene должен
	# открывать приложение, а не отдавать 404.
	#
	# index.html кешировать нельзя: он ссылается на ресурсы по хешу,
	# и закешированная копия после обновления тянет старую сборку —
	# пользователь видит прежний интерфейс и не понимает, почему.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		# Инструмент хранит инвентарь внутренней инфраструктуры,
		# поэтому запрещаем встраивание и утечку адресов через Referer.
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
	}

	log {
		# В URL не должно быть значений находок, но путь и так пишется —
		# держим уровень скупым.
		level ERROR
	}
}
