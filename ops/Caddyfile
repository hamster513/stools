# Один вход для интерфейса и API.
#
# Прокси нужен не для красоты: фронт и API обязаны быть одного
# происхождения, иначе сессионная cookie с SameSite=Strict не доедет.
# Сюда же позже встанет ATT&CK Navigator, и по той же причине —
# iframe с ним должен быть same-origin, чтобы навязать ему тему.
#
# Адрес — из STOOLS_SITE_ADDRESS (ops/.env, прокинута в compose): пустое
# значение или его отсутствие даёт голый ":80" (лаборатория без TLS, как
# сейчас); настоящее имя хоста ("stools.example.ru") — Caddy сам заводит
# сертификат и слушает 443 с автоматическим HTTPS (см. README «Запуск»).
#
# Откуда сертификат — STOOLS_TLS (README «Безопасность», «TLS»):
#   auto     — по умолчанию: автоматический HTTPS Caddy (ACME, нужен выход
#              в интернет к удостоверяющему центру);
#   internal — свой удостоверяющий центр Caddy, без сети; его корневой
#              сертификат (/data/caddy/pki/authorities/local/root.crt в
#              контейнере web) раздаётся на рабочие места;
#   files    — свои сертификат и ключ: ops/tls/cert.pem и ops/tls/key.pem
#              (монтируются в /etc/caddy/tls, ops/tls/ в git не попадает).
# Кому верить в X-Forwarded-For и X-Forwarded-Proto — STOOLS_TRUSTED_PROXIES.
# По умолчанию 127.0.0.1/32: снаружи контейнера с этого адреса никто не
# приходит, то есть не доверяем никому, и адрес клиента — тот, кто
# подключился к Caddy (стенд, прямой доступ). За своим прокси (nginx на
# хосте, ops/nginx-stools.conf.example) — private_ranges или его сеть:
# тогда Caddy берёт адрес клиента и схему https от прокси. Без этого все
# входы выглядят одним адресом (порог неудачных входов по IP закроет вход
# всем), а проверка Origin увидит http вместо https и отклонит запись.
# strict — адрес клиента берётся справа налево, до первого недоверенного:
# подставленный клиентом X-Forwarded-For не подменит настоящий адрес.
{
	servers {
		trusted_proxies static {$STOOLS_TRUSTED_PROXIES:127.0.0.1/32}
		trusted_proxies_strict
	}
}

(tls-auto) {
}
(tls-internal) {
	tls internal
}
(tls-files) {
	tls /etc/caddy/tls/cert.pem /etc/caddy/tls/key.pem
}

{$STOOLS_SITE_ADDRESS::80} {
	import tls-{$STOOLS_TLS:auto}
	encode gzip

	# HSTS только когда соединение и правда https: под голым :80 заголовок
	# был бы ложью и заставил бы браузер требовать TLS, которого нет.
	@https expression `{scheme} == "https"`
	header @https Strict-Transport-Security "max-age=31536000"

	# IRP deploys independently and keeps both path prefixes.
	handle /irp/* {
		reverse_proxy {$STOOLS_IRP_WEB_UPSTREAM:irp-web:80} {
			header_up -Cookie
		}
	}
	handle /api/irp/* {
		reverse_proxy {$STOOLS_IRP_API_UPSTREAM:irp-api:8000} {
			header_up X-Forwarded-For {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	# API проксируется как есть, префикс сохраняется.
	# Потолок тела — наибольший из лимитов API (500 МБ у VM) с запасом
	# на multipart; точные лимиты по путям держит сам API (api/limits.py).
	handle /api/* {
		request_body {
			max_size 600MB
		}
		# Адрес клиента — только тот, кто подключился к Caddy: присланный
		# снаружи X-Forwarded-For затирается. API (uvicorn с
		# --forwarded-allow-ips '*') берёт адрес из этого заголовка, по нему
		# журнал пишет ip и считает неудачные входы (api/routers/auth.py).
		reverse_proxy api:8000 {
			header_up X-Forwarded-For {client_ip}
			header_up X-Real-IP {client_ip}
		}
	}

	# Ресурсы с хешем в имени неизменяемы: имя меняется вместе
	# с содержимым, поэтому их можно кешировать надолго.
	handle /static/* {
		root * /srv
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Всё остальное — статика интерфейса с фолбэком на index.html:
	# маршрутизация клиентская, и прямой заход на /hygiene должен
	# открывать приложение, а не отдавать 404.
	#
	# index.html кешировать нельзя: он ссылается на ресурсы по хешу,
	# и закешированная копия после обновления тянет старую сборку —
	# пользователь видит прежний интерфейс и не понимает, почему.
	handle {
		root * /srv
		header Cache-Control "no-cache"
		try_files {path} /index.html
		file_server
	}

	header {
		# Инструмент хранит инвентарь внутренней инфраструктуры,
		# поэтому запрещаем встраивание и утечку адресов через Referer.
		X-Frame-Options "DENY"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
		# script-src без unsafe-inline: сборка Vite не эмитит inline-скриптов
		# (frontend/dist/index.html — только внешний <script type=module>),
		# так что ослаблять незачем. style-src с unsafe-inline остаётся:
		# компоненты задают style={{...}} инлайново (виртуализация списков,
		# цвета находок), и это не статический файл — hash/nonce сюда не
		# подставить.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
	}

	log {
		# В URL не должно быть значений находок, но путь и так пишется —
		# держим уровень скупым.
		level ERROR
	}
}
