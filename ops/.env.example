# Скопируйте в ops/.env и заполните. Файл с настоящими значениями
# в git не попадает — см. .gitignore.

# Пароль к базе. Любая длинная случайная строка.
POSTGRES_PASSWORD=

# Ключ подписи сессий. Смена ключа разлогинивает всех — это нормально.
# Сгенерировать: openssl rand -hex 32
STOOLS_SESSION_SECRET=

# На каком порту слушать интерфейс.
STOOLS_PORT=8080

# Адрес сайта для Caddy (ops/Caddyfile). Пусто/не задано — голый HTTP на
# STOOLS_PORT, как для лаборатории. Настоящее имя хоста, например
# stools.example.ru, — Caddy сам заводит сертификат и включает HTTPS
# (нужно ещё опубликовать порт 443, по умолчанию стек публикует только 80).
STOOLS_SITE_ADDRESS=

# Флаг Secure у сессионной cookie. По умолчанию true — инструмент хранит
# инвентарь внутренней инфраструктуры, модель доступа не слабее, чем к
# анализируемым системам. Поставьте false только для лаборатории по
# обычному HTTP без STOOLS_SITE_ADDRESS (иначе Safari выбрасывает cookie,
# и вход молча не срабатывает).
STOOLS_SESSION_COOKIE_SECURE=true

# Необязательное: имя базы и пользователя, если умолчания не подходят.
# POSTGRES_DB=kbaudit
# POSTGRES_USER=kbaudit
