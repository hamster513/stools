# Скопируйте в ops/.env и заполните. Файл с настоящими значениями
# в git не попадает — см. .gitignore.

# Пароль к базе. Любая длинная случайная строка.
POSTGRES_PASSWORD=

# Ключ хеширования сессий и шифрования сохранённых секретов (пароли
# подключений AD, KSC, MaxPatrol VM, секрет клиента OIDC).
# Сгенерировать: openssl rand -hex 32
# Смена ключа завершает все сессии И делает уже зашифрованные секреты
# нечитаемыми: второго ключа для расшифровки нет, а reseal-secrets шифрует
# только открытые значения. Поэтому меняйте ключ до первого шифрования
# (до reseal-secrets и до первого сохранения подключений) — иначе после
# смены каждый секрет вводится заново. После правки нужен
# `docker compose … up -d api`, restart не перечитывает окружение.
# Порядок — README «Безопасность», «Ротация STOOLS_SESSION_SECRET».
STOOLS_SESSION_SECRET=

# На каком порту слушать интерфейс.
STOOLS_PORT=8080

# Адрес сайта для Caddy (ops/Caddyfile). Пусто/не задано — голый HTTP на
# STOOLS_PORT, как для лаборатории. Настоящее имя хоста, например
# stools.example.ru, — Caddy сам заводит сертификат и включает HTTPS
# (нужно ещё опубликовать порт 443, по умолчанию стек публикует только 80).
STOOLS_SITE_ADDRESS=

# Откуда Caddy берёт сертификат, когда STOOLS_SITE_ADDRESS — имя хоста или IP:
#   auto     — автоматически по ACME (нужен выход в интернет);
#   internal — свой удостоверяющий центр Caddy, без сети; корневой сертификат
#              раздаётся на рабочие места (README «Безопасность», «TLS»);
#   files    — свои ops/tls/cert.pem и ops/tls/key.pem.
STOOLS_TLS=auto

# Флаг Secure у сессионной cookie. По умолчанию true — инструмент хранит
# инвентарь внутренней инфраструктуры, модель доступа не слабее, чем к
# анализируемым системам. Поставьте false только для лаборатории по
# обычному HTTP без STOOLS_SITE_ADDRESS (иначе Safari выбрасывает cookie,
# и вход молча не срабатывает).
STOOLS_SESSION_COOKIE_SECURE=true

# Необязательное: имя базы и пользователя, если умолчания не подходят.
# POSTGRES_DB=kbaudit
# POSTGRES_USER=kbaudit

# --- Только для сервера (ops/docker-compose.prod.yml, docs/install.md) ---

# Версия образов — тег в реестре, например ffa11c4.
# STOOLS_VERSION=
# Реестр и пространство имён образов stools-api и stools-web.
# STOOLS_REGISTRY=hamster5133
# Каталог данных на сервере: db (Postgres) и archives (выгрузки).
# STOOLS_DATA_ROOT=/data/stools
# Кому Caddy верит в X-Forwarded-*: адреса nginx. По умолчанию private_ranges
# (порт web опубликован только на 127.0.0.1).
# STOOLS_TRUSTED_PROXIES=private_ranges
# Образ Postgres, если его берут из своего реестра.
# STOOLS_POSTGRES_IMAGE=postgres:16-alpine
# Файл сертификатов сервера (публичные УЦ + корпоративный) для исходящих
# HTTPS/LDAPS. Debian/Ubuntu — умолчание; RHEL/CentOS/Astra:
# STOOLS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt
# STOOLS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
